[Unit]
Description=XGuard first-boot initialisation
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/stacks/xguard
StandardOutput=append:/var/log/xguard-startup.log
StandardError=append:/var/log/xguard-startup.log
ExecStart=/bin/bash /opt/stacks/xguard/init/generate-env.sh
ExecStart=/bin/bash /opt/stacks/xguard/init/generate-compose.sh
ExecStart=/usr/bin/docker compose -f /opt/stacks/xguard/docker-compose.yml up -d

[Install]
WantedBy=multi-user.target
