# Use userspace WireGuard implementation, useful on systems without native WireGuard support
# Set to 0/1
XGUARD_USERSPACE=0
# XGuard GRPC URL, e.g.: xguard-grpc.mycompany.com
XGUARD_GRPC_URL=<XGUARD_GRPC_URL>
# Token from XGuard app to secure gRPC connection, available on network page.
XGUARD_TOKEN=<XGUARD_TOKEN>
# Defines how often (in seconds) should interface statistics be sent to XGuard server
XGUARD_STATS_PERIOD=30
