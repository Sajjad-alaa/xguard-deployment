## General Core configuration ##
XGUARD_AUTH_SECRET=<64_CHAR_RANDOM_SECRET>
XGUARD_YUBIBRIDGE_SECRET=<64_CHAR_RANDOM_SECRET>
XGUARD_GATEWAY_SECRET=<64_CHAR_RANDOM_SECRET>
XGUARD_SECRET_KEY=<64_CHAR_RANDOM_SECRET>
XGUARD_URL=<YOUR_XGUARD_CORE_URL>
# XGUARD_WEBAUTHN_RP_ID=<YOUR_XGUARD_WEBAUTHN_RP_ID>
# More details about RSA key here:
# https://docs.xguard.local/deployment-strategies/openid-rsa-key
# XGUARD_OPENID_KEY=rsakey.pem
# Accepted values: debug, info, warn, error
XGUARD_LOG_LEVEL=info

## Proxy/Enrollment configuration ##
XGUARD_ENROLLMENT_URL=<YOUR_XGUARD_ENROLLMENT_URL> # The URL of your Proxy - will be displayed during enrollment, email messages or desktop client configuration
XGUARD_PROXY_URL=<YOUR_XGUARD_PROXY_GRPC_URL>
# XGUARD_COOKIE_INSECURE=true  # If you are accessing the dashboard via HTTP instead of HTTPS, set this to true.

## GRPC Certificate configuration ##
# More info about securing gRPC communication here: https://docs.xguard.local/deployment-strategies/grpc-ssl-communication#custom-ssl-ca-and-certificates
# XGUARD_GRPC_CERT=/certs/core.pem
# XGUARD_GRPC_KEY=/certs/core.key
# XGUARD_PROXY_GRPC_CA=/certs/ca.pem

## Database configuration ##
# For the database container
POSTGRES_DB=xguard
POSTGRES_USER=xguard
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
# For the Core container
XGUARD_DB_HOST=db
XGUARD_DB_PORT=5432
XGUARD_DB_PASSWORD=<YOUR_DB_PASSWORD>
XGUARD_DB_USER=xguard
XGUARD_DB_NAME=xguard
